{
    "version": 2,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/next-build"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ],
    "env": {
        "DATABASE_URL": "@database_url",
        "NEXTAUTH_SECRET": "@nextauth_secret",
        "NEXTAUTH_URL": "@nextauth_url",
        "CRON_SECRET": "@cron_secret"
    },
    "crons": [
        {
            "path": "/api/cron/cleanup",
            "schedule": "0 0 * * *"
        }
    ]
}